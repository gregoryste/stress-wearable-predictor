POSTGRES_PASSWORD=demo_local

# Opções: exemplo (demo.sinais) ou mqtt (demo.mensagens_mqtt)
DASHBOARD_FONTE=exemplo

# Simulador executado no Windows, com o Mosquitto publicado na porta 1883
MQTT_BROKER=localhost
MQTT_PORT=1883
WEARABLE_USER=S2

# Caminho até o .pkl do participante. Vazio ativa o modo de exemplo.
WESAD_PKL_PATH=

SIM_SPEED=1.0
SIM_HORARIO=14:00
SIM_RUIDO_DB=45.0